// Hand-written fixture: atomicAdd(float) whose return value is unused, plus a kernel without atomics.
.version 8.7
.target sm_70
.address_size 64

.visible .entry k_atomic(
	.param .u64 k_atomic_param_0,
	.param .f32 k_atomic_param_1
)
{
	.reg .f32 	%f<4>;
	.reg .b64 	%rd<5>;

	ld.param.u64 	%rd1, [k_atomic_param_0];
	ld.param.f32 	%f2, [k_atomic_param_1];
	cvta.to.global.u64 	%rd4, %rd1;
	atom.global.add.f32 	%f3, [%rd4], %f2;
	ret;
}

.visible .entry k_other(
	.param .u64 k_other_param_0
)
{
	.reg .b64 	%rd<2>;

	ld.param.u64 	%rd1, [k_other_param_0];
	ret;
}
