// Hand-written fixture: division, reciprocal and square-root approximations.
.version 8.7
.target sm_70
.address_size 64

.visible .entry k_approx(
	.param .u64 k_approx_param_0
)
{
	.reg .f32 	%f<10>;
	.reg .b64 	%rd<3>;

	ld.param.u64 	%rd1, [k_approx_param_0];
	cvta.to.global.u64 	%rd2, %rd1;
	ld.global.f32 	%f1, [%rd2];
	ld.global.f32 	%f2, [%rd2+4];
	div.approx.ftz.f32 	%f3, %f1, %f2;
	div.full.f32 	%f4, %f1, %f2;
	rcp.approx.ftz.f32 	%f5, %f1;
	sqrt.approx.ftz.f32 	%f6, %f1;
	rsqrt.approx.ftz.f32 	%f7, %f1;
	div.approx.f32 	%f8, %f1, %f2;
	st.global.f32 	[%rd2], %f7;
	ret;
}
