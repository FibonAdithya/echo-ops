// Hand-written fixture: two functions that each get a $ECHO_SKIP_0 label (labels are function-local).
.version 8.7
.target sm_70
.address_size 64

.func  (.param .b32 func_retval0) f_skip(
	.param .b32 f_skip_param_0
)
{
	.reg .pred 	%p<2>;
	.reg .f32 	%f<3>;

	ld.param.f32 	%f1, [f_skip_param_0];
	mov.f32 	%f2, %f1;
	setp.gt.ftz.f32 	%p1, %f1, 0f00000000;
	@%p1 lg2.approx.ftz.f32 	%f2, %f1;
	st.param.f32 	[func_retval0], %f2;
	ret;
}

.visible .entry k_skip(
	.param .u64 k_skip_param_0
)
{
	.reg .pred 	%p<2>;
	.reg .f32 	%f<4>;
	.reg .b64 	%rd<3>;

	ld.param.u64 	%rd1, [k_skip_param_0];
	cvta.to.global.u64 	%rd2, %rd1;
	ld.global.f32 	%f1, [%rd2];
	mov.f32 	%f2, %f1;
	setp.gt.ftz.f32 	%p1, %f1, 0f00000000;
	@%p1 ex2.approx.ftz.f32 	%f2, %f1;
	{ // callseq 0, 0
	.param .b32 param0;
	st.param.f32 	[param0], %f2;
	.param .b32 retval0;
	call.uni (retval0), f_skip, (param0);
	ld.param.f32 	%f3, [retval0];
	} // callseq 0
	st.global.f32 	[%rd2], %f3;
	ret;
}
