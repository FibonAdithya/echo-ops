// Hand-written fixture: a predicated base-2 exponential approximation.
.version 8.7
.target sm_70
.address_size 64

.visible .entry k_ex2(
	.param .u64 k_ex2_param_0
)
{
	.reg .pred 	%p<2>;
	.reg .f32 	%f<3>;
	.reg .b64 	%rd<3>;

	ld.param.u64 	%rd1, [k_ex2_param_0];
	cvta.to.global.u64 	%rd2, %rd1;
	ld.global.f32 	%f1, [%rd2];
	mov.f32 	%f2, 0f00000000;
	setp.gt.ftz.f32 	%p1, %f1, 0f00000000;
	@%p1 ex2.approx.ftz.f32 %f2, %f1;
	st.global.f32 	[%rd2], %f2;
	ret;
}
