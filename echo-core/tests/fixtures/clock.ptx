// Hand-written fixture: clock64() and clock().
.version 8.7
.target sm_70
.address_size 64

.visible .entry k_clock(
	.param .u64 k_clock_param_0
)
{
	.reg .b16 	%rs<3>;
	.reg .f32 	%f<3>;
	.reg .b32 	%r<2>;
	.reg .b64 	%rd<4>;

	ld.param.u64 	%rd1, [k_clock_param_0];
	cvta.to.global.u64 	%rd2, %rd1;
	mov.u64 	%rd3, %clock64;
	mov.u32 	%r1, %clock;
	st.global.u64 	[%rd2], %rd3;
	st.global.u32 	[%rd2+8], %r1;
	ret;
}
